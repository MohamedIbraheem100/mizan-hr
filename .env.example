# Copy to .env and fill in. NEVER commit .env.
# Keys live in GitHub Secrets / Vercel env vars in production.

# ---- App ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO

# ---- LLM gateway (provider chosen by env, see apps/api/mizan/llm/gateway.py) ----
# Provider chain, tried in order. Item = name or name:model. Groq rate-limits PER MODEL
# on the free tier, so several Groq models = several buckets.
LLM_PROVIDERS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini
# Legacy pair (used only if LLM_PROVIDERS is empty)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=                # optional paid fallback

# ---- Database: Neon Postgres in prod (pooled URL, ?sslmode=require); docker compose overrides locally ----
# Apply schema with: cd apps/api && alembic upgrade head
DATABASE_URL=

# ---- Rate limit / cache (Upstash Redis in prod; docker compose overrides locally) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Web (apps/web). Public: baked into the browser bundle at build time ----
# Local: http://localhost:8000. Vercel project mizan-hr: https://mizan-hr-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000
