# Copy to .env and fill in. NEVER commit .env.
# Keys live in GitHub Secrets / Vercel env vars in production.

# ---- App ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO

# ---- LLM gateway (provider chosen by env, see apps/api/mizan/llm/gateway.py) ----
LLM_PROVIDER=gemini            # primary:  gemini | groq | openai
LLM_FALLBACK_PROVIDER=groq     # fallback: gemini | groq | openai | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=                # optional paid fallback

# ---- Database (Neon Postgres in prod; docker compose overrides this locally) ----
DATABASE_URL=

# ---- Rate limit / cache (Upstash Redis in prod; docker compose overrides locally) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
